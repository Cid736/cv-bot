GROQ_API_KEY=gsk_...
PORT=5001
CONTACT_EMAIL=contact@example.com
CONTACT_LINKEDIN=https://www.linkedin.com/in/yourprofile/
# Reverse proxies in front of the app (e.g. 1 on Render). Makes the rate limiter
# use the client IP written by the proxy instead of a spoofable header. 0 = off.
TRUSTED_PROXIES=0
# Private dashboard at /stats?token=<value>. Leave empty to disable it.
STATS_TOKEN=
# Where anonymous stats are stored (Render free: wiped on each deploy).
STATS_DB=data/stats.db
